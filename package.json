{
  "name": "quantterminal",
  "version": "0.3.1",
  "description": "一站式个人量化研究平台",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:renderer\"",
    "dev:backend": "python src/backend/main.py",
    "dev:renderer": "cd src/renderer && npm run dev",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "cd src/renderer && npm run build",
    "build:electron": "electron-builder",
    "test": "cd src/renderer && npm test",
    "lint": "cd src/renderer && npm run lint"
  },
  "dependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "build": {
    "appId": "com.wolfjkd.quantterminal",
    "productName": "QuantTerminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*",
      "src/backend/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}