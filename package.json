{
  "name": "quantterminal",
  "version": "0.4.1",
  "description": "一站式个人量化研究平台",
  "author": "wolfjkd",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:renderer\"",
    "dev:backend": "cd src && python -m backend.main",
    "dev:renderer": "cd src/renderer && npm run dev",
    "build": "npm run build:backend && npm run build:renderer && npm run build:electron",
    "build:backend": "python scripts/build_backend.py",
    "build:renderer": "cd src/renderer && npm run build",
    "build:electron": "electron-builder",
    "test": "cd src/renderer && npm test",
    "lint": "cd src/renderer && npm run lint"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.wolfjkd.quantterminal",
    "productName": "QuantTerminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-backend/quantterminal-backend.exe",
        "to": "backend/quantterminal-backend.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuantTerminal"
    }
  }
}